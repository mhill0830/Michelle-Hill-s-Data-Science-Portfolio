## Setup
library(readxl)
partnutfs = read_excel("particulate_nutrients_data.xlsx", sheet = 2)
names(partnutfs)[names(partnutfs) == "Particulate Total N, mg/L"] = "ptn"
names(partnutfs)[names(partnutfs) == "Particulate Total P, ug/L"] = "ptp"
names(partnutfs)[names(partnutfs) == "Particulate Organic Carbon, mg/L"] = "poc"
names(partnutfs)[names(partnutfs) == "Total Suspended Solids, mg/L"] = "tss"
names(partnutfs)[names(partnutfs) == "YEARL"] = "year"

##  QUESTION 1 HYPOTHESES:
##  H0: Nutrient particle levels in Lake Michigan are not changing over time.  B1 = 0 
##  H1: Nutrient particle levels in Lake Michigan are changing over time.  B1 does not equal 0 

##  Created subset of data for rows only related to Lake Michigan
partnutmi = subset(partnutfs, LAKE == "Michigan")
year = as.numeric(partnutmi$YEAR)

##  Fitting linear model to the particulate nutrients being analyzed
##  Using log to reduce skewness of values
ptnmodel = lm(log(ptn) ~ year, data = partnutmi)
summary(ptnmodel)

ptpmodel = lm(log(ptp) ~ year, data = partnutmi)
summary(ptpmodel)

pocmodel = lm(log(poc) ~ year, data = partnutmi)
summary(pocmodel)

tssmodel = lm(log(tss) ~ year, data = partnutmi)
summary(tssmodel)

##  Generating plots to illustrate linear regression assumption validation,
##    one for each nutrient
par(mfrow = c(2,2))
plot(ptnmodel)				## PTN Model
par(mfrow = c(1,1))

par(mfrow = c(2,2))
plot(ptpmodel)				## PTP Model
par(mfrow = c(1,1))

par(mfrow = c(2,2))
plot(pocmodel)				## POC Model
par(mfrow = c(1,1))

par(mfrow = c(2,2))
plot(tssmodel)				## TSS Model
par(mfrow = c(1,1))

##  Generating ACF plots to assess linear regression assumption of
##    independence
acf(resid(ptnmodel), main="ACF residuals: PTN")
acf(resid(ptpmodel), main="ACF residuals: PTP")
acf(resid(pocmodel), main="ACF residuals: POC")
acf(resid(tssmodel), main="ACF residuals: TSS")



##  QUESTION 2 HYPOTHESES:
##  H0: A model using particulate nutrients and season predicts LAKE no better than a baseline model.
##  H1: A model using particulate nutrients and season predicts LAKE better than a baseline model.

##  Ensuring only rows noted as Spring or Summer are included in the dataset
data2 = partnutfs[partnutfs$SEASON %in% c("Spring", "Summer"), ]

##  This model only needed the LAKE, SEASON, and four particulate nutrients to test the hypothesis
data2 = data2[, c("LAKE", "SEASON", "ptn", "ptp", "poc", "tss")]

##  Removed empty rows from the dataset (only removed one row)
data2 = data2[complete.cases(data2), ]

##  Convert categorical variables to factors
data2$LAKE = factor(data2$LAKE)
data2$SEASON = factor(data2$SEASON)

##  Log transform particulate nutrients and use of a very tiny constant (+1e-6) to ensure safe math
data2$log_ptn = log(data2$ptn + 1e-6)
data2$log_ptp = log(data2$ptp + 1e-6)
data2$log_poc = log(data2$poc + 1e-6)
data2$log_tss = log(data2$tss + 1e-6)

##  Train / test split (30% test set)
set.seed(123)

##  Having R randomly choose 30% of observations (150 rows) without replacement to set aside for testing
n = nrow(data2)
test_index = sample(1:n, size = round(0.30 * n))

train = data2[-test_index, ]			##  training set (other 70% or 350 rows)
test  = data2[test_index, ]				##  test set

##  Baseline model for H0 (most common lake)
baseline_lake = names(sort(table(train$LAKE), decreasing = TRUE))[1]
pred_baseline = factor(rep(baseline_lake, nrow(test)),levels = levels(test$LAKE))

acc_baseline = mean(pred_baseline == test$LAKE)
acc_baseline


##  "nnet" enables fitting of neural networks and multinominal logistic regression models for classification
library(nnet)

##  Season-only classification model
m_season = multinom(LAKE ~ SEASON, data = train, trace = FALSE)
pred_season = predict(m_season, newdata = test)

acc_season = mean(pred_season == test$LAKE)
acc_season

##  Full model: Season + particulate nutrients
m_full = multinom(LAKE ~ SEASON + log_ptn + log_ptp + log_poc + log_tss, data = train, trace = FALSE)

pred_full = predict(m_full, newdata = test)
acc_full = mean(pred_full == test$LAKE)
acc_full

## Confusion matrix for interpretation
table(True = test$LAKE, Predicted = pred_full)

## Permutation test (formal hypothesis test - assessing if the full model performed better than baseline)

B = 1000
perm_acc = numeric(B)

set.seed(123)

## Loop of 1000 permutations
## Creating a temporary copy of the training set of observations
## Destroying the relationship between LAKE labels and predictors
## Fitting the same multinominal model on permuted data with random labels, the model is learning noise
for (b in 1:B) {
  train_perm = train							
  train_perm$LAKE = sample(train_perm$LAKE)		
  m_perm = multinom(							
    LAKE ~ SEASON + log_ptn + log_ptp + log_poc + log_tss,
    data = train_perm,
    trace = FALSE
  )												
## Applies the model to test data, outputs predicted lake labels
## Compares predictions to actuals and calculates permutation accuracy
  pred_perm = predict(m_perm, newdata = test)	
  perm_acc[b] = mean(pred_perm == test$LAKE)	
}

##  if p-value < 0.05, classification accuracy is not due to chance
p_value = mean(perm_acc >= acc_full)			
p_value			##  Output: 0 :)
										

## Confusion Matrix Heat Map - illustrates both accurate and inaccurate lake label predictions
cm = table(True = test$LAKE, Pred = pred_full)
cm_df = as.data.frame(cm)

library(ggplot2)       
ggplot(cm_df, aes(x = Pred, y = True, fill = Freq)) +
  geom_tile() +
  geom_text(aes(label = Freq), color = "black") +
  scale_fill_viridis_c(option = "C") +
  labs(title = "Confusion Matrix (Full Model)",
       x = "Predicted Lake", y = "True Lake")
       


##  Accuracy Bar Chart - illustrates classification was much more accurate using the full model of season and particulate nutrient to predict lake label
acc_df = data.frame(Model = c("Baseline", "Season-only", "Full"),
  Accuracy = c(acc_baseline, acc_season, acc_full)
)

ggplot(acc_df, aes(x = Model, y = Accuracy)) + geom_col() +
