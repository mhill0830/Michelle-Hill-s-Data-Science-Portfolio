## Count outliers
count_outliers = function(x) {
  q1 = quantile(x, 0.25, na.rm = TRUE)
  q3 = quantile(x, 0.75, na.rm = TRUE)
  iqr = q3 - q1
  sum(x > (q3 + 1.5 * iqr), na.rm = TRUE)
}

## Aggregate by lake
anomaly_summary = aggregate(total_suspended_solids_mg_l ~ LAKE, data = partnutfs,FUN = function(x) c(outliers = count_outliers(x), total = sum(!is.na(x))))


