plot(x_lake, median_lake,
     ylim = range(c(lower_lake, upper_lake), na.rm = TRUE),
     xaxt = "n",
     xlab = "Lake",
     ylab = " TSS (mg/L)",
     main = " TSS outlier bounds by lake (IQR) with outliers colored by season")

