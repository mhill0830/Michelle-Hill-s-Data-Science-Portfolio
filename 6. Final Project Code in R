## PTN ASSESSMENT  ## PTN ASSESSMENT  ## PTN ASSESSMENT
library(readxl)
df = read_excel("particulate_nutrients_data.xlsx",
                 sheet = 2)

##  Create a working dataset for ONE nutrient (PTN)

df_ptn = df[, c("LAKE",
                 "SEASON",
                 "Particulate Total N, mg/L")]
                 
##  Remove missing values because Logistic regression cannot handle them
df_ptn = df_ptn[!is.na(df_ptn$LAKE), ]
df_ptn = df_ptn[!is.na(df_ptn$SEASON), ]
df_ptn = df_ptn[!is.na(df_ptn$`Particulate Total N, mg/L`), ]

##  Factor LAKE and SEASON to categorical variables
df_ptn$LAKE   = as.factor(df_ptn$LAKE)
df_ptn$SEASON = as.factor(df_ptn$SEASON)

##  Define outliers using the IQR rule within each lake
##  Calculate Q1 (25th percentile) within each lake
q1_by_lake = ave(df_ptn$`Particulate Total N, mg/L`,
                  df_ptn$LAKE,
                  FUN = function(x) quantile(x, 0.25, na.rm = TRUE))

##  Calculate Q3 (75th percentile) within each lake
q3_by_lake = ave(df_ptn$`Particulate Total N, mg/L`,
                  df_ptn$LAKE,
                  FUN = function(x) quantile(x, 0.75, na.rm = TRUE))

##  Compute IQR within each lake
iqr_by_lake = q3_by_lake - q1_by_lake

##  Define lower and upper bounds for outliers
lower_bound = q1_by_lake - 1.5 * iqr_by_lake
upper_bound = q3_by_lake + 1.5 * iqr_by_lake

##  Create binary outlier flag (TRUE = outlier)
df_ptn$outlier = (
  df_ptn$`Particulate Total N, mg/L` < lower_bound |
  df_ptn$`Particulate Total N, mg/L` > upper_bound
)

##  Quick check: number of outliers vs non-outliers
table(df_ptn$outlier)

##  Fit logistic regression model
##  Outcome: outlier (TRUE / FALSE)
##  Predictors: SEASON + LAKE
model_ptn = glm(outlier ~ SEASON + LAKE,
                 data = df_ptn,
                 family = binomial)

summary(model_ptn)

##  Compare performance of reduced model to Full model
model_ptn_reduced = glm(outlier ~ LAKE,
                         data = df_ptn,
                         family = binomial)

anova(model_ptn_reduced, model_ptn, test = "Chisq")

## Output: Pr-value = 0.01423, which is < 0.05 so reject H0

## Descriptive visual shows proportion of outliers by season
outlier_rate_by_season = tapply(df_ptn$outlier,
                                 df_ptn$SEASON,
                                 mean)
barplot(outlier_rate_by_season,
        ylab = "Proportion of observations flagged as outliers",
        xlab = "Season",
        main = "PTN outlier rate by season")  
        
        
